# ==========================================
# KONFIGURASI SERVER PRODUKSI FOTOPROMOSI
# ==========================================

# GEMINI_API_KEY: Diperlukan untuk endpoint AI pembuat kata promosi di server.
# Dapatkan dari Google AI Studio (https://aistudio.google.com/apikey).
# Di AI Studio, disetel melalui Settings > Secrets.
GEMINI_API_KEY="AIzaSy..."

# PORT: Port server Express (default: 3000 di Cloud Run / hosting)
PORT=3000

# NODE_ENV: Set ke 'production' saat deploy di server live
NODE_ENV="production"

# ALLOWED_ORIGINS: Domain asal yang diizinkan untuk CORS (opsional).
# Gunakan jika frontend dan backend berada di domain berbeda. Pisahkan koma jika lebih dari satu.
# Contoh: "https://fotopromosi.web.app,https://admin.fotopromosi.com"
ALLOWED_ORIGINS="*"

# APP_URL: URL publik aplikasi HTTPS (misal Cloud Run service URL)
APP_URL="https://ais-dev-6cje3wmvfq7afjtonigap7-702679394276.asia-east1.run.app"

# ==========================================
# KONFIGURASI FRONTEND (VITE CLIENT)
# ==========================================

# VITE_API_BASE_URL: URL API backend untuk client.
# KOSONGKAN JIKA FULL-STACK MONOLITHIC (frontend & backend di domain yang sama).
# Hanya isi jika frontend dihosting terpisah (misal GitHub Pages / Vercel):
# Contoh: "https://api.fotopromosi.com"
VITE_API_BASE_URL=""
